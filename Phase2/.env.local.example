# ─── Supabase ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ─── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Sunrise Cafe

# ─── Razorpay ───────────────────────────────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YOUR_KEY
RAZORPAY_KEY_SECRET=your_razorpay_secret

# ─── WhatsApp Phase 2 (Wati — https://wati.io) ──────────────
# WATI_API_ENDPOINT: from Wati dashboard → API → Endpoint URL
#   e.g. https://live-mt-server.wati.io/YOUR_ACCOUNT_ID
# WATI_ACCESS_TOKEN: from Wati dashboard → API → Access Token
WATI_API_ENDPOINT=
WATI_ACCESS_TOKEN=

# ─── Optional: OpenWeatherMap (Phase 4) ─────────────────────
OPENWEATHER_API_KEY=
